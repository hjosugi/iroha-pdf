{
  "name": "iroha-pdf",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace @iroha-pdf/mobile",
    "dev:desktop": "npm run tauri:dev --workspace @iroha-pdf/desktop",
    "dev:desktop:web": "npm run dev --workspace @iroha-pdf/desktop",
    "build:desktop": "npm run build --workspace @iroha-pdf/desktop",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "site": "node site/build.mjs --out site/dist",
    "validate:site": "node site/verify.mjs",
    "validate:eas": "node release/mobile/validate-eas-config.mjs",
    "brand:generate": "bash scripts/generate-brand-assets.sh",
    "validate:brand": "node release/branding/validate-assets.mjs",
    "verify:dependency-patches": "node release/supply-chain/verify-dependency-patches.mjs",
    "store:screenshots:desktop": "UPDATE_STORE_SCREENSHOTS=1 npm run store:screenshots --workspace @iroha-pdf/desktop",
    "sbom:npm": "node release/supply-chain/prepare-output.mjs && cyclonedx-npm --omit dev --output-reproducible --validate --output-file artifacts/npm.cdx.json",
    "audit:licenses:npm": "node release/supply-chain/audit-npm-licenses.mjs artifacts/npm.cdx.json",
    "e2e": "npm run e2e --workspace @iroha-pdf/desktop",
    "e2e:tauri": "npm run e2e:tauri --workspace @iroha-pdf/desktop",
    "e2e:tauri:ceiling": "npm run e2e:tauri:ceiling --workspace @iroha-pdf/desktop",
    "verify:emulator": "npm run verify:emulator --workspace @iroha-pdf/mobile"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "spdx-expression-parse": "4.0.0",
    "typescript": "~7.0.2",
    "vitest": "^4.0.18",
    "xcode": "3.0.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
